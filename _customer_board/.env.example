# Linear Settings → Security & access → Personal API keys 에서 발급
LINEAR_API_KEY=

# 일반 ERP·ORD 접수 및 개발 큐가 머무는 Anasa 팀 UUID
LINEAR_TEAM_ID=f4837910-b73f-4908-b4d8-f25ad31c2f61

# 결정적인 고위험 변경만 이동하는 Anasa core 팀 UUID
LINEAR_CORE_TEAM_ID=34367eba-05e8-43f7-9bab-3f68690390b1

# 참고용 — 이미 만들어둔 라벨 UUID (스크립트가 이름으로도 조회하지만 있으면 빠름)
LINEAR_LABEL_고객보드=1607e7f9-4801-438a-99f2-a9e1ce709d85
LINEAR_LABEL_고객확인=2aeabf09-336c-4d15-a414-0df40fd4fe01
LINEAR_LABEL_자동분류미확정=88b2d1fc-1b87-4cef-b343-eac300eae1f3

# 내부 변환 큐 페이지 접근 제한용
INTERNAL_QUEUE_PASSWORD=
INTERNAL_SESSION_SECRET=

# Linear 웹훅과 5분 복구 워커가 함께 사용하는 HMAC secret
LINEAR_WEBHOOK_SECRET=

# 자동 배정 풀. 실제 활성 Linear member UUID만 입력한다.
